{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Predictive agent profile in the swarm.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "displayName": { "type": "string", "description": "Public name of the agent." },
        "phoneNumber": { "type": "string", "description": "Verified phone number." },
        "influencePoints": { "type": "integer", "description": "Current influence points (IP)." },
        "predictabilityScore": { "type": "number", "description": "Neural sync score percentage." },
        "accuracy": { "type": "number", "description": "Historical prediction accuracy." },
        "rank": { "type": "integer", "description": "Global swarm rank." },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "System access level." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Node initialization timestamp." }
      },
      "required": ["uid", "displayName", "influencePoints", "role"]
    },
    "Prediction": {
      "title": "Electoral Prediction",
      "description": "A single predictive signal for a constituency.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the predicting agent." },
        "constituencyId": { "type": "string", "description": "Target constituency node ID." },
        "predictedParty": { "type": "string", "description": "Predicted winning party (LDF, UDF, NDA, OTH)." },
        "confidence": { "type": "integer", "description": "Agent conviction level (10-100)." },
        "margin": { "type": "integer", "description": "Predicted victory margin." },
        "timestamp": { "type": "string", "format": "date-time", "description": "Signal lock-in time." },
        "phase": { "type": "string", "description": "Election phase during prediction." }
      },
      "required": ["userId", "constituencyId", "predictedParty", "confidence"]
    },
    "GlobalConfig": {
      "title": "Global System Configuration",
      "description": "Central parameters for the election lifecycle.",
      "type": "object",
      "properties": {
        "phase": { "type": "string", "enum": ["Pre-Campaign", "Campaign", "Polling", "Counting"], "description": "Current election phase." }
      },
      "required": ["phase"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/predictions/{predictionId}": {
      "schema": "Prediction",
      "description": "Individual prediction signals."
    },
    "/config/global": {
      "schema": "GlobalConfig",
      "description": "Global system state."
    }
  }
}
